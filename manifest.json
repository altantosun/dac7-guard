{
  "manifest_version": 3,
  "name": "DAC7 Guard – EU Marketplace & PStTG Tracker",
  "short_name": "DAC7 Guard",
  "version": "0.2.0",
  "description": "Track EU DAC7 limits (30 sales / > €2,000) across Kleinanzeigen, eBay, Vinted, Willhaben, Leboncoin & more – 100% local.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "DAC7 Guard – EU Marketplace Limit Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/dashboard/dashboard.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.kleinanzeigen.de/*"
      ],
      "js": [
        "src/content/overlay-widget.js",
        "src/content/kleinanzeigen.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.de/sh/ord*",
        "https://www.ebay.de/mys/sold*",
        "https://www.ebay.de/mys/home*",
        "https://www.ebay.at/sh/ord*",
        "https://www.ebay.fr/sh/ord*",
        "https://www.ebay.it/sh/ord*",
        "https://www.ebay.es/sh/ord*",
        "https://www.ebay.nl/sh/ord*",
        "https://www.ebay.be/sh/ord*",
        "https://www.ebay.ie/sh/ord*",
        "https://www.ebay.pl/sh/ord*"
      ],
      "js": [
        "src/content/overlay-widget.js",
        "src/content/ebay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.vinted.de/my_orders*",
        "https://www.vinted.de/member/*",
        "https://www.vinted.fr/my_orders*",
        "https://www.vinted.fr/member/*",
        "https://www.vinted.it/my_orders*",
        "https://www.vinted.it/member/*",
        "https://www.vinted.es/my_orders*",
        "https://www.vinted.es/member/*",
        "https://www.vinted.nl/my_orders*",
        "https://www.vinted.nl/member/*",
        "https://www.vinted.pl/my_orders*",
        "https://www.vinted.pl/member/*",
        "https://www.vinted.be/my_orders*",
        "https://www.vinted.be/member/*",
        "https://www.vinted.at/my_orders*",
        "https://www.vinted.at/member/*",
        "https://www.vinted.pt/my_orders*",
        "https://www.vinted.pt/member/*"
      ],
      "js": [
        "src/content/overlay-widget.js",
        "src/content/vinted.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.willhaben.at/iad/*",
        "https://www.leboncoin.fr/ad/*",
        "https://www.leboncoin.fr/compte/*",
        "https://www.marktplaats.nl/v/*",
        "https://www.marktplaats.nl/my-account/*",
        "https://www.2dehands.be/v/*",
        "https://www.2ememain.be/v/*",
        "https://es.wallapop.com/item/*",
        "https://it.wallapop.com/item/*",
        "https://pt.wallapop.com/item/*",
        "https://www.subito.it/*",
        "https://www.etsy.com/your/orders/*"
      ],
      "js": [
        "src/content/overlay-widget.js",
        "src/content/eu-marketplaces.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
